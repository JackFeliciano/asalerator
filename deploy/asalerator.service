[Unit]
Description=Asalerator pipeline register
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/asalerator
Environment=ASALERATOR_BASE=/asalerator/
ExecStart=/usr/bin/php -S 127.0.0.1:8107 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/asalerator
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
